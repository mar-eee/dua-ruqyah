      "content_sections": [
        {
          "index": 0,
          "key": "text",
          "source": "'দোয়া ও রুকইয়াহ' একটি পূর্ণাঙ্গ ইসলামিক অ্যাপ, যা আপনার আধ্যাত্মিক পথচলার সঙ্গী হিসেবে ডিজাইন করা হয়েছে। IRD ফাউন্ডেশনের ভালোবাসা ও নিষ্ঠার সাথে নির্মিত এই অ্যাপটি আল্লাহর সাথে আপনার সম্পর্ককে আরও গভীর করার জন্য বিশুদ্ধ দোয়া, রুকইয়াহ এবং বিভিন্ন ইসলামিক উপকরণ প্রদান করে।",
          "target": ""
        },
        {
          "index": 2,
          "key": "text",
          "source": "অ্যাপের ভেতরে কী কী থাকছে",
          "target": ""
        },
        {
          "index": 4,
          "key": "text",
          "source": "এই অ্যাপটি ইসলামিক আধ্যাত্মিক সম্পদের এক বিশাল সংগ্রহশালা:",
          "target": ""
        },
        {
          "index": 6,
          "key": "header",
          "source": "বিশাল দোয়া সংগ্রহ:",
          "target": ""
        },
        {
          "index": 6,
          "key": "details",
          "source": "দৈনন্দিন জীবন, বিশেষ মুহূর্ত ও বিভিন্ন পরিস্থিতি অনুযায়ী সাজানো ২০০-এর বেশি বিশুদ্ধ দোয়ার সমাহার।",
          "target": ""
        },
        {
          "index": 8,
          "key": "header",
          "source": "রুকইয়াহ শারইয়াহ:",
          "target": ""
        },
        {
          "index": 8,
          "key": "details",
          "source": "আধ্যাত্মিক নিরাময় ও সুরক্ষার জন্য কুরআন ও সুন্নাহভিত্তিক আয়াত ও দোয়ার পূর্ণাঙ্গ সংগ্রহ।",
          "target": ""
        },
        {
          "index": 10,
          "key": "header",
          "source": "নামাজের সময়:",
          "target": ""
        },
        {
          "index": 10,
          "key": "details",
          "source": "আপনার অবস্থান অনুযায়ী একাধিক গণনা পদ্ধতিসহ নির্ভুল নামাজের সময়সূচি।",
          "target": ""
        },
        {
          "index": 12,
          "key": "header",
          "source": "মুখস্থ করার পরিকল্পনা:",
          "target": ""
